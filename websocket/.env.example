# Copy to .env. Prefer the local go2rtc relay so only one process opens the camera.
RTSP_UNIFIED_BASE=rtsp://127.0.0.1:8554
RTSP_URL_CAMERA1=rtsp://127.0.0.1:8554/cam01
RTSP_URL_CAMERA2=rtsp://127.0.0.1:8554/cam02
WS_HOST=127.0.0.1
WS_PORT_CAMERA1=8089
WS_PORT_CAMERA2=8090
MQTT_WS_PORT=1884
MQTT_TCP_HOST=127.0.0.1
MQTT_TCP_PORT=1883
# Optional absolute path when ffmpeg is not in PATH.
FFMPEG_PATH=
