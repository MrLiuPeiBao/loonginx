# 高质量配置（画质优先，适合稳定网络）
# 基础配置来自 env_profiles/common.env

# RTSP 拉流参数（空表示默认）
YOLO_RTSP_CAPTURE_OPTIONS=
# 拉流缓冲帧数量
YOLO_CAPTURE_BUFFER_SIZE=4
# 是否丢帧
YOLO_DROP_FRAMES=false
# 最大丢帧数
YOLO_DROP_MAX_FRAMES=0
# 是否启用低延迟模式
YOLO_RTSP_LOW_LATENCY=false

# 帧率
YOLO_FPS=25
# 画面宽度/高度
YOLO_FRAME_WIDTH=640
YOLO_FRAME_HEIGHT=360

# 编码器（软件编码）
YOLO_GST_ENCODER=x264enc
# 编码器参数（空表示默认）
YOLO_GST_ENCODER_PROPS=
