# 实时/低延迟配置（适合实时展示）
# 基础配置来自 env_profiles/common.env

# RTSP 拉流低延迟参数
YOLO_RTSP_CAPTURE_OPTIONS=rtsp_transport;tcp|fflags;nobuffer|flags;low_delay|max_delay;0|probesize;32|analyzeduration;0
# 拉流缓冲帧数量（越小越低延迟）
YOLO_CAPTURE_BUFFER_SIZE=1
# 是否丢帧以减少延迟
YOLO_DROP_FRAMES=true
# 最大丢帧数
YOLO_DROP_MAX_FRAMES=10
# 是否启用低延迟模式
YOLO_RTSP_LOW_LATENCY=true

# 帧率
YOLO_FPS=10
# 画面宽度/高度
YOLO_FRAME_WIDTH=960
YOLO_FRAME_HEIGHT=540
# YOLO 推理输入尺寸，和输出分辨率分离，避免 720p 输出拖慢检测
YOLO_INFERENCE_SIZE=512
# YOLO 推理设备
YOLO_COMPUTE_DEVICE=cuda:0

# 硬件编码器（视机器支持情况）
YOLO_GST_ENCODER=x264enc
# 编码器参数（低延迟优先）
YOLO_GST_ENCODER_PROPS=bitrate=2500 speed-preset=ultrafast tune=zerolatency key-int-max=15 bframes=0 rc-lookahead=0 sync-lookahead=0
