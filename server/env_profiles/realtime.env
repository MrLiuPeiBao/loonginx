# 实时/低延迟配置（适合实时展示）
# 基础配置来自 env_profiles/common.env

# RTSP 拉流低延迟参数
YOLO_RTSP_CAPTURE_OPTIONS=rtsp_transport;tcp|fflags;nobuffer|flags;low_delay|max_delay;0|probesize;32|analyzeduration;0
# 拉流缓冲帧数量（越小越低延迟）
YOLO_CAPTURE_BUFFER_SIZE=1
# 是否丢帧以减少延迟
YOLO_DROP_FRAMES=true
# 最大丢帧数
YOLO_DROP_MAX_FRAMES=10
# 是否启用低延迟模式
YOLO_RTSP_LOW_LATENCY=true

# 帧率
YOLO_FPS=20
# 画面宽度/高度
YOLO_FRAME_WIDTH=640
YOLO_FRAME_HEIGHT=360

# 硬件编码器（视机器支持情况）
YOLO_GST_ENCODER=nvh264enc
# 编码器参数（低延迟优先）
YOLO_GST_ENCODER_PROPS=preset=p1 tune=ultra-low-latency rc-mode=cbr bitrate=2000 gop-size=20 rc-lookahead=0 zerolatency=true
