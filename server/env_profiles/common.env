# 是否跳过依赖安装（true = 不安装依赖）
SKIP_PIP_INSTALL=true
# 是否自动安装依赖（true 会自动 pip install requirements）
INSTALL_DEPENDENCIES=false

# 应用名称（用于日志与 MQTT 下位机标识）
APP_NAME=sensor_server

# 是否启动图形界面 GUI（true = 启动）
GUI_ENABLED=true

# 可选：GUI 程序版本（legacy 为旧版），不填则默认
#GUI_APP=legacy

# MQTT Broker 地址（通常是本机或现场服务器 IP）
MQTT_BROKER=localhost
# MQTT 端口（默认 1883）
MQTT_PORT=1883
# MQTT 用户名（如未启用认证可留空）
MQTT_USERNAME=
# MQTT 密码（如未启用认证可留空）
MQTT_PASSWORD=

# 是否优先使用消息内的 device_id（多设备场景用；单设备可保持 false）
PREFER_PAYLOAD_DEVICE_ID=false
# 命令超时时间（秒），超过则标记为 timeout
COMMAND_TIMEOUT_SECONDS=15

# MySQL 数据库地址
MYSQL_HOST=localhost
# MySQL 端口
MYSQL_PORT=3306
# MySQL 用户名
MYSQL_USER=root
# MySQL 密码
MYSQL_PASSWORD=root
# MySQL 数据库名称
MYSQL_DATABASE=loognix

# API 监听地址（外网访问请设置为本机 IP 或 0.0.0.0）
API_HOST=192.168.31.9
# API 监听端口
API_PORT=8000

# 是否启用 YOLO 行人识别
YOLO_ENABLED=false
# YOLO 运行模式：thread(同进程线程) / process(独立进程)
YOLO_RUN_MODE=thread
# RTSP 输入地址（摄像头流）
YOLO_RTSP_INPUT=rtsp://admin:HIKKBA12@192.168.31.64:554/Streaming/Channels/101
# RTSP 输出地址（可选，用于转推）
YOLO_RTSP_OUTPUT=
# YOLO 模型文件路径
YOLO_MODEL_PATH=yolov8n.pt
# 摄像头设备 ID
YOLO_DEVICE_ID=camera-01
# 摄像头位置标识
YOLO_LOCATION=gate-a
# 截图间隔（秒）
YOLO_SCREENSHOT_INTERVAL=5
# 置信度阈值（越高越严格）
YOLO_CONFIDENCE_THRESHOLD=0.35
# 是否启用 FFmpeg 推流（true/false）
YOLO_FFMPEG_ENABLED=false

# 是否启用音频监测
AUDIO_ENABLED=false
# 音频运行模式：thread(同进程线程) / process(独立进程)
AUDIO_RUN_MODE=thread
# RTSP 输入地址（音频流）
AUDIO_RTSP_INPUT=rtsp://admin:HIKKBA12@192.168.31.64:554/Streaming/Channels/101
# 音频设备 ID
AUDIO_DEVICE_ID=mic-01
# 音频位置标识
AUDIO_LOCATION=gate-a
# 采样率（Hz）
AUDIO_SAMPLE_RATE=16000
# 音频窗口长度（秒）
AUDIO_WINDOW_SECONDS=1.0
# 音频特征阈值（0 表示不过滤，全部写入）
AUDIO_THRESHOLD_CENTROID=0
AUDIO_THRESHOLD_BANDWIDTH=0
AUDIO_THRESHOLD_ROLLOFF=0
AUDIO_THRESHOLD_FLATNESS=0
AUDIO_THRESHOLD_FLUX=0
# RMS 阈值（0 表示不过滤）
AUDIO_THRESHOLD_RMS=0

# 媒体存储模式：database(存库) / filesystem(落盘)
MEDIA_STORAGE_MODE=database
# 媒体文件存储目录（仅 filesystem 时生效）
MEDIA_STORAGE_DIR=media
# 是否保存图像（filesystem 模式下可单独关闭）
MEDIA_STORE_IMAGE=true
# 是否保存音频（filesystem 模式下可单独关闭）
MEDIA_STORE_AUDIO=true

# Uvicorn 日志级别（info/warning/error）
UVICORN_LOG_LEVEL=info
