# MQTT Broker 地址
MQTT_BROKER=192.168.12.21
# MQTT 端口
MQTT_PORT=1883
# MQTT 下位机 ID（设备唯一标识）
MQTT_CLIENT_ID=loongson_sensor_gateway
# MQTT 用户名（如未启用认证可留空）
MQTT_USERNAME=
# MQTT 密码（如未启用认证可留空）
MQTT_PASSWORD=
# MQTT 心跳间隔（秒）
MQTT_KEEPALIVE=60
# MQTT 发布 QoS（0 或 1）
MQTT_PUBLISH_QOS=0
# 是否启用离线缓存（断网后缓冲）
MQTT_OFFLINE_QUEUE_ENABLED=false
# 离线缓存最大条数
MQTT_OFFLINE_QUEUE_MAX_ITEMS=500
# 离线缓存最大字节数
MQTT_OFFLINE_QUEUE_MAX_BYTES=2000000

# PLC 是否启用
PLC_ENABLED=true
# PLC IP 地址
PLC_HOST=192.168.2.1
# PLC 端口
PLC_PORT=502
# PLC 站号
PLC_UNIT_ID=1
# PLC 通信超时（秒）
PLC_TIMEOUT=2.0
# PLC 连接超时（秒）
PLC_CONNECT_TIMEOUT=2.0
# VB 偶地址字节是否为高字节（常见为 true）
PLC_EVEN_BYTE_IS_HIGH=true
# REAL(32位浮点) 字序（big/little）
PLC_FLOAT_WORD_ORDER=big
# REAL(32位浮点) 字节序（big/little）
PLC_FLOAT_BYTE_ORDER=big
# PLC 状态轮询间隔（秒）
PLC_STATUS_POLL_INTERVAL=0.5
# PLC 心跳间隔（秒）
PLC_HEARTBEAT_INTERVAL=1.0
# PLC 脉冲写入保持时间（秒）
PLC_COMMAND_PULSE_SECONDS=0.1

# 传感器串口
SERIAL_PORT=/dev/ttyS4
# 传感器串口波特率
SERIAL_BAUDRATE=9600
# 传感器串口读超时（秒）
SERIAL_TIMEOUT=0.5

# RFID 串口
RFID_SERIAL_PORT=/dev/ttyS0
# RFID 串口波特率
RFID_SERIAL_BAUDRATE=9600

# 消息结构版本号（用于兼容升级）
MESSAGE_SCHEMA_VERSION=1
